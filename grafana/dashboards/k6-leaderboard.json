          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "alias": "POST /v1/scores/:username (p95)",
          "datasource": { "uid": "influxdb", "type": "influxdb" },
          "query": "SELECT percentile(\"value\", 95) AS \"p95\" FROM \"http_req_duration\" WHERE \"name\" = 'post-score' AND $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "GET /v1/scores (top-N) (p95)",
          "datasource": { "uid": "influxdb", "type": "influxdb" },
          "query": "SELECT percentile(\"value\", 95) AS \"p95\" FROM \"http_req_duration\" WHERE \"name\" = 'top-scores' AND $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "C",
          "alias": "GET /v1/scores/:username (neighborhood) (p95)",
          "datasource": { "uid": "influxdb", "type": "influxdb" },
          "query": "SELECT percentile(\"value\", 95) AS \"p95\" FROM \"http_req_duration\" WHERE \"name\" = 'neighborhood' AND $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Time to First Byte (TTFB)",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 7 },
      "datasource": { "uid": "influxdb", "type": "influxdb" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
