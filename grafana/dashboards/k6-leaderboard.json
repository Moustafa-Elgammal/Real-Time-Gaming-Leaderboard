        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "alias": "Received",
          "datasource": { "uid": "influxdb", "type": "influxdb" },
          "query": "SELECT non_negative_derivative(sum(\"value\"), 1s) AS \"rx\" FROM \"data_received\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "Sent",
          "datasource": { "uid": "influxdb", "type": "influxdb" },
          "query": "SELECT non_negative_derivative(sum(\"value\"), 1s) AS \"tx\" FROM \"data_sent\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
