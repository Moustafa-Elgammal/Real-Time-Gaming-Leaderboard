          "datasource": { "uid": "influxdb", "type": "influxdb" },
          "query": "SELECT mean(\"value\") AS \"ttfb\" FROM \"http_req_waiting\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "p95 TTFB",
          "datasource": { "uid": "influxdb", "type": "influxdb" },
          "query": "SELECT percentile(\"value\", 95) AS \"ttfb_p95\" FROM \"http_req_waiting\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Data Throughput",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 7 },
      "datasource": { "uid": "influxdb", "type": "influxdb" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "spanNulls": true },
          "unit": "Bps",
          "min": 0
